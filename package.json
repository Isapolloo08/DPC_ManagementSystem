{
  "name": "dpc-chms-workspace",
  "version": "1.0.0",
  "description": "Daet Presbyterian Church Management Desktop Application",
  "author": "Daet Presbyterian Church",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"blue.bold,green.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:client && npm run build:server",
    "electron:start": "concurrently -k -s \"command-ELECTRON\" -n \"SERVER,CLIENT,ELECTRON\" -c \"blue.bold,green.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:client\" \"wait-on tcp:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:preview": "npm run build && cross-env NODE_ENV=production electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:dir": "npm run build && electron-builder --dir",
    "migrate:pg": "npm --prefix server run migrate:pg",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@sentry/node": "^10.75.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "debug": "^4.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "org.daetpresbyterian.chms",
    "productName": "DPC Management System",
    "icon": "client/src/assets/icon.ico",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "client/dist/**/*",
      "server/dist/**/*"
    ],
    "asarUnpack": [
      "server/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "server/.env",
        "to": "server/.env"
      },
      {
        "from": "server/dist",
        "to": "server/dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "client/src/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DPC Management System",
      "runAfterFinish": true
    }
  }
}
