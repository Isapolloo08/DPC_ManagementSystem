{
  "name": "dpc-chms-workspace",
  "version": "1.0.0",
  "description": "Daet Presbyterian Church Management Desktop Application",
  "author": "Daet Presbyterian Church",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"blue.bold,green.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:client && npm run build:server",
    "electron:start": "concurrently -k -n \"SERVER,CLIENT,ELECTRON\" -c \"blue.bold,green.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:client\" \"wait-on tcp:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:preview": "npm run build:client && cross-env NODE_ENV=production electron .",
    "electron:build": "npm run build:client && electron-builder",
    "electron:build:dir": "npm run build:client && electron-builder --dir",
    "migrate:pg": "npm --prefix server run migrate:pg",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "org.daetpresbyterian.chms",
    "productName": "DPC Management System",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DPC Management System"
    }
  }
}