# Server Port Configuration
PORT=4000

# Secret Key for JWT Authentication (Replace with a random 32+ character string in your local .env)
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# Optional local-only demo account switcher. Never enabled in production.
ENABLE_DEMO_MODE=false

# Notification email delivery. SMTP values may be configured in the Admin UI;
# environment values override stored settings. SMTP_ENCRYPTION_KEY protects any
# app password saved through Settings and should remain stable across restarts.
SMTP_ENCRYPTION_KEY=replace-with-a-long-random-secret
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_NAME=Daet Presbyterian Church
# SMTP_FROM_EMAIL=
# PASTOR_EMAIL=

# Render Free blocks SMTP ports. Use HTTPS delivery with a verified Resend domain.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=visits@your-verified-domain.example

# PostgreSQL Database Connection URL
# Format: postgres://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/chms_db
