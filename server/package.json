{
  "name": "dpc-chms-server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "copy:migrations": "powershell -Command \"if (!(Test-Path dist/db/migrations)) { New-Item -ItemType Directory -Force -Path dist/db/migrations }; Copy-Item -Path src/db/migrations/* -Destination dist/db/migrations -Force\"",
    "build": "tsc && npm run copy:migrations",
    "start": "npm run build && node dist/index.js",
    "dev": "npm run build && node --watch dist/index.js",
    "seed": "npm run build && node dist/db/seed.js",
    "migrate:pg": "npm run build && node dist/db/migrate-postgres.js",
    "test": "npm run build && node dist/index.test.js"
  },
  "dependencies": {
    "@types/debug": "^4.1.13",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "debug": "^4.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
