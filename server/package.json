{
  "name": "dpc-chms-server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "copy:migrations": "node -e \"const fs=require('fs'); fs.mkdirSync('dist/db/migrations', {recursive:true}); fs.cpSync('src/db/migrations', 'dist/db/migrations', {recursive:true});\"",
    "build": "tsc && npm run copy:migrations",
    "start": "npm run build && node dist/index.js",
    "dev": "npm run build && node --watch dist/index.js",
    "seed": "npm run build && node dist/db/seed.js",
    "clean:db": "npm run build && node dist/db/clear-database.js",
    "test": "npm run build && node dist/index.test.js",
    "test:load": "node scripts/load-test.js"
  },
  "dependencies": {
    "@sentry/node": "^10.75.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.13",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "debug": "^4.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "socket.io": "^4.8.3",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/compression": "^1.8.1",
    "@types/pino-http": "^5.8.4",
    "autocannon": "^8.0.0"
  }
}
